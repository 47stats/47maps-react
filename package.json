{
  "name": "@47stats/47maps-react",
  "version": "0.10.0",
  "packageManager": "npm@11.16.0",
  "description": "47stats APIとMapbox GL JSを利用したReact向け統計地図コンポーネント",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "public/help",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/47stats/47maps-react.git"
  },
  "homepage": "https://github.com/47stats/47maps-react#readme",
  "bugs": {
    "url": "https://github.com/47stats/47maps-react/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "npm run docs:build && vite",
    "build": "npm run docs:build && tsc -b && vite build",
    "build:lib": "npm run clean && tsc --project tsconfig.lib.json && vite build --config vite.config.lib.ts",
    "build:pkg": "npm pack",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "prepack": "npm run docs:build && npm run build:lib",
    "prepublishOnly": "npm test && npm run typecheck && npm run lint",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "release:check": "npm test && npm run typecheck && npm run lint && npm pack --dry-run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node -e \"require('fs').rmSync('public/help', { recursive: true, force: true })\" && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "mapbox",
    "mapbox-gl",
    "react",
    "react-mapbox-gl",
    "typescript",
    "47maps",
    "47stats-api"
  ],
  "author": "Nippon Statistics Center",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@47stats/api": "^0.9.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.0.2",
    "@mapbox/mapbox-gl-language": "^1.0.1",
    "@turf/turf": "^7.1.0",
    "ajv": "^6.15.0",
    "flowbite-react": "^0.9.0",
    "mapbox-gl": "^3.27.0",
    "react-colorful": "^5.6.1",
    "react-icons": "5.0.1",
    "react-map-gl": "^8.1.0",
    "recharts": "^2.14.1"
  },
  "devDependencies": {
    "@47stats/api": "^0.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/geojson": "^7946.0.14",
    "@types/mapbox__mapbox-gl-geocoder": "^5.0.0",
    "@types/mapbox-gl": "^3.4.0",
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-tailwindcss": "^3.17.0",
    "postcss": "^8.4.37",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^6.4.3",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
